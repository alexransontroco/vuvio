<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vuvio · Dossier de présentation</title>
<style>
@font-face{font-family:Manrope;font-weight:400;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:Manrope;font-weight:500;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:Manrope;font-weight:600;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:Manrope;font-weight:700;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:Manrope;font-weight:800;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}

:root{
  --bg:#06111e; --bg2:#0a1c2f; --card:#0b2135; --card2:#0e2a42;
  --line:rgba(30,214,229,.22); --line2:rgba(181,199,214,.14);
  --text:#f2f8fd; --muted:#a9bccc; --dim:#7890a4;
  --cyan:#1ed6e5; --green:#5ce1b9; --amber:#ffc864;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#020810}
body{font-family:Manrope,Inter,Arial,sans-serif;color:var(--text);-webkit-font-smoothing:antialiased;padding:24px 0}
.deck{display:flex;flex-direction:column;align-items:center;gap:24px}
.frame{width:1280px;height:720px;position:relative}
.slide{width:1280px;height:720px;position:relative;overflow:hidden;background:
  radial-gradient(900px 500px at 85% -10%,rgba(30,214,229,.10),transparent 60%),
  linear-gradient(180deg,var(--bg2),var(--bg));padding:52px 64px 44px;display:flex;flex-direction:column;transform-origin:top left}
.kicker{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin-bottom:14px}
h1{font-size:44px;line-height:1.08;font-weight:800;letter-spacing:-.02em}
h2{font-size:38px;line-height:1.1;font-weight:800;letter-spacing:-.02em;max-width:1050px}
h2 em,h1 em{font-style:normal;color:var(--cyan)}
h3{font-size:18px;font-weight:700;line-height:1.25}
p{font-size:15px;line-height:1.5;color:var(--muted)}
.lead{font-size:17px;line-height:1.5;color:var(--muted);max-width:900px;margin-top:14px}
.foot{position:absolute;left:64px;right:64px;bottom:18px;display:flex;justify-content:space-between;align-items:flex-end;font-size:10.5px;color:var(--dim);gap:40px}
.foot .src{max-width:1000px;line-height:1.4}
.foot .pg{color:var(--cyan);font-weight:700;white-space:nowrap}
.ph{color:var(--amber);border:1px dashed rgba(255,200,100,.6);border-radius:4px;padding:0 5px;font-weight:600;white-space:nowrap;background:rgba(255,200,100,.06)}
.card{background:linear-gradient(180deg,rgba(14,42,66,.85),rgba(11,33,53,.85));border:1px solid var(--line);border-radius:14px}
.tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--bg);background:var(--cyan);padding:3px 8px;border-radius:999px}
.tag.ghost{background:transparent;color:var(--cyan);border:1px solid var(--line)}
.img{background-size:cover;background-position:center;border-radius:12px}
.phone{border-radius:22px;border:2px solid rgba(30,214,229,.35);box-shadow:0 20px 50px rgba(0,0,0,.45);background-size:cover;background-position:top center}
.note{font-size:11px;color:var(--dim);font-style:italic}

/* 1 cover */
.s-cover{padding:0;background:#030b16}
.s-cover .bgimg{position:absolute;inset:0;background-size:cover;background-position:center 30%;opacity:.95}
.s-cover .shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,11,22,.96) 0%,rgba(3,11,22,.78) 44%,rgba(3,11,22,.15) 75%)}
.s-cover .in{position:relative;padding:64px 72px;height:100%;display:flex;flex-direction:column}
.s-cover .logo{width:230px}
.s-cover h1{font-size:68px;margin-top:118px;max-width:640px}
.s-cover .sub{font-size:20px;line-height:1.45;color:#d4e2ee;max-width:560px;margin-top:22px}
.s-cover .meta{margin-top:auto;display:flex;gap:28px;font-size:13px;color:var(--muted);letter-spacing:.04em}
.s-cover .meta b{color:var(--cyan);font-weight:700}

/* 2 positioning */
.s-pos{flex-direction:row;gap:48px}
.s-pos .l{flex:1;display:flex;flex-direction:column}
.s-pos .statement{font-size:24px;line-height:1.4;font-weight:600;color:var(--text);margin-top:4px}
.s-pos .statement em{font-style:normal;color:var(--cyan)}
.s-pos dl{margin-top:26px;display:grid;grid-template-columns:150px 1fr;row-gap:0;border-top:1px solid var(--line2)}
.s-pos dt,.s-pos dd{padding:11px 0;border-bottom:1px solid var(--line2);font-size:14.5px;line-height:1.45}
.s-pos dt{color:var(--cyan);font-weight:700;font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding-top:13px}
.s-pos dd{color:var(--muted)}
.s-pos dd b{color:var(--text);font-weight:600}
.s-pos .r{width:330px;display:flex;flex-direction:column;gap:10px;padding-top:6px}
.s-pos .r .phone{height:560px;width:330px;background-position:center}

/* 3 problem */
.cols3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:30px}
.prob{padding:24px 24px 22px}
.prob .who{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin-bottom:10px}
.prob h3{margin-bottom:10px}
.prob .big{font-size:40px;font-weight:800;color:var(--text);letter-spacing:-.02em;line-height:1;margin:6px 0 4px}
.punch{margin-top:auto;margin-bottom:22px;display:flex;align-items:center;gap:22px;padding:22px 28px;border-left:4px solid var(--cyan);background:rgba(30,214,229,.06);border-radius:0 12px 12px 0}
.punch .t{font-size:26px;font-weight:800;letter-spacing:-.01em}
.punch .t em{font-style:normal;color:var(--cyan)}

/* 4 solution */
.sol{display:flex;flex-direction:column;overflow:hidden}
.sol .img{height:200px;border-radius:13px 13px 0 0}
.sol .b{padding:18px 22px 20px}
.sol .n{font-size:12px;color:var(--cyan);font-weight:800;letter-spacing:.1em;margin-bottom:6px}
.sol h3{margin-bottom:8px}
.formula{margin-top:auto;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.formula .eq{font-size:22px;font-weight:800;letter-spacing:.02em}
.formula .eq span{color:var(--cyan)}
.formula p{max-width:560px;text-align:right}

/* 5 product */
.s-prod .row{display:flex;gap:36px;margin-top:22px;align-items:flex-start}
.s-prod .ph3{display:flex;gap:26px}
.s-prod .scr{width:190px}
.s-prod .scr .phone{width:190px;height:330px}
.s-prod .scr h3{margin-top:14px;display:flex;align-items:center;gap:8px}
.s-prod .scr p{font-size:13.5px;margin-top:4px}
.s-prod .side{flex:1;display:flex;flex-direction:column;gap:12px}
.flow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.flow div{padding:12px 12px;border:1px solid var(--line);border-radius:10px;background:rgba(11,33,53,.7)}
.flow b{display:block;font-size:11px;color:var(--cyan);letter-spacing:.12em;text-transform:uppercase;margin-bottom:3px}
.flow span{font-size:12.5px;color:var(--muted);line-height:1.35;display:block}
.feat{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.feat div{padding:12px 14px;border-radius:10px;border:1px solid var(--line2);background:rgba(11,33,53,.5)}
.feat b{font-size:14px;display:block;margin-bottom:3px}
.feat span{font-size:12.5px;color:var(--muted);line-height:1.4;display:block}
.sidehead{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);font-weight:700;margin-top:4px}

/* 6 terrains */
.terr{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
.ter{overflow:hidden;display:flex;flex-direction:column}
.ter .pics{display:flex;height:118px}
.ter .pics div{flex:1;background-size:cover;background-position:center}
.ter .b{padding:16px 20px 16px}
.ter h3{font-size:19px;margin-bottom:10px;display:flex;align-items:center;gap:10px}
.ter h3 i{font-style:normal;font-size:11px;font-weight:800;color:var(--bg);background:var(--cyan);border-radius:6px;padding:2px 7px}
.ter table{width:100%;border-collapse:collapse}
.ter td{font-size:12.8px;line-height:1.38;padding:6px 0;vertical-align:top;border-top:1px solid var(--line2);color:var(--muted)}
.ter td:first-child{width:78px;color:var(--dim);font-weight:700;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding-top:8px}
.ter tr.pay td{color:var(--text)}
.ter tr.pay td:first-child{color:var(--green)}
.why{margin-top:16px;display:flex;gap:22px;align-items:center;padding:16px 22px;border-radius:12px;background:rgba(92,225,185,.07);border:1px solid rgba(92,225,185,.28)}
.why b{color:var(--green);font-size:13px;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
.why p{font-size:14px;color:#cfe0ea}

/* 7 market */
.mk{display:grid;grid-template-columns:1.05fr 1fr 1fr;gap:18px;margin-top:26px}
.mkc{padding:22px 24px}
.mkc .lab{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin-bottom:14px}
.stat{margin-bottom:16px}
.stat .v{font-size:38px;font-weight:800;letter-spacing:-.02em;line-height:1}
.stat .v small{font-size:18px;font-weight:700;color:var(--muted);margin-left:4px}
.stat p{font-size:13.5px;margin-top:5px;line-height:1.4}
.mkc .so{font-size:12.5px;color:var(--muted);line-height:1.45;border-top:1px solid var(--line2);padding-top:12px}
.tam{margin-top:18px;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:16px 22px;border:1px dashed rgba(255,200,100,.45);border-radius:12px}
.tam p{font-size:14px}

/* 8 competition */
.s-comp .wrap{display:flex;gap:26px;margin-top:22px}
.ctab{flex:1;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:rgba(11,33,53,.6)}
.ctab th{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);text-align:left;padding:12px 16px;background:rgba(14,42,66,.9);font-weight:700}
.ctab td{font-size:13px;line-height:1.4;padding:11px 16px;border-top:1px solid var(--line2);color:var(--muted);vertical-align:top}
.ctab td:first-child{color:var(--text);font-weight:700;width:150px}
.ctab td:first-child small{display:block;font-weight:500;color:var(--dim);font-size:11px;margin-top:2px}
.ctab tr.dead td:first-child small{color:#ff9a8a}
.ctab tr.us td{background:rgba(30,214,229,.09);color:var(--text)}
.ctab tr.us td:first-child{color:var(--cyan)}
.lessons{width:340px;padding:22px 22px}
.lessons h3{font-size:15px;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:14px}
.lessons ol{list-style:none;counter-reset:l}
.lessons li{counter-increment:l;padding:12px 0;border-top:1px solid var(--line2);font-size:13.5px;line-height:1.45;color:var(--muted)}
.lessons li b{color:var(--text);display:block;font-size:14.5px;margin-bottom:3px}
.lessons li b::before{content:counter(l) ". ";color:var(--green)}

/* 9 model */
.s-mod .top{display:flex;gap:16px;margin-top:20px;align-items:stretch}
.s-mod .stp{display:flex;gap:14px;align-items:center}
.s-mod .stp .phone{width:150px;height:250px;border-radius:16px}
.s-mod .stp .pnl{width:250px;height:140px;border-radius:12px;background-size:cover;background-position:top;border:1px solid var(--line)}
.s-mod .steps{display:flex;flex-direction:column;gap:10px;justify-content:center;width:290px}
.s-mod .steps div{font-size:13.5px;line-height:1.4;color:var(--muted);padding-left:30px;position:relative}
.s-mod .steps div b{color:var(--text)}
.s-mod .steps div i{position:absolute;left:0;top:0;font-style:normal;width:21px;height:21px;border-radius:50%;border:1px solid var(--cyan);color:var(--cyan);font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center}
.rev{border-collapse:separate;border-spacing:0;width:100%;margin-top:18px;border:1px solid var(--line);border-radius:14px;overflow:hidden}
.rev th{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);text-align:left;padding:10px 14px;background:rgba(14,42,66,.9)}
.rev td{font-size:13px;line-height:1.38;padding:9px 14px;border-top:1px solid var(--line2);color:var(--muted);background:rgba(11,33,53,.55)}
.rev td:first-child{color:var(--text);font-weight:700;width:200px}
.rev td.when{white-space:nowrap;color:var(--green);font-weight:600;width:150px}

/* 10 status */
.s-stat .grid{display:grid;grid-template-columns:1.25fr 1fr;gap:20px;margin-top:22px}
.mvp{display:flex;gap:20px;padding:20px}
.mvp .phone{width:170px;height:300px;flex:none;border-radius:16px}
.mvp ul{list-style:none;margin-top:10px}
.mvp li{font-size:13.5px;color:var(--muted);padding:6px 0 6px 22px;position:relative;border-top:1px solid var(--line2);line-height:1.35}
.mvp li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:800}
.mvp li.wip::before{content:"…";color:var(--amber)}
.thumbs{display:flex;gap:8px;margin-top:14px}
.thumbs div{flex:1;height:110px;border-radius:9px;background-size:cover;background-position:center;position:relative}
.thumbs span{position:absolute;left:6px;bottom:6px;font-size:10px;font-weight:700;background:rgba(3,11,22,.8);padding:2px 6px;border-radius:5px}
.trac{padding:20px 22px}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.kpis div{padding:12px 14px;border-radius:10px;border:1px solid var(--line2);background:rgba(3,11,22,.35)}
.kpis b{display:block;font-size:22px;margin-bottom:2px}
.kpis span{font-size:12px;color:var(--muted)}
.meas{margin-top:14px;font-size:13px;color:var(--muted);line-height:1.5}
.meas b{color:var(--text)}

/* 11 roadmap */
.phases{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px;position:relative}
.phase{padding:18px 20px}
.phase .when{font-size:12px;font-weight:800;color:var(--cyan);letter-spacing:.1em;text-transform:uppercase}
.phase h3{margin:6px 0 8px;font-size:17px}
.phase ul{list-style:none}
.phase li{font-size:13px;color:var(--muted);line-height:1.4;padding:4px 0 4px 14px;position:relative}
.phase li::before{content:"";position:absolute;left:0;top:11px;width:5px;height:5px;border-radius:50%;background:var(--cyan)}
.risks{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.risk{padding:11px 14px;border-radius:10px;border:1px solid var(--line2);background:rgba(11,33,53,.5)}
.risk b{display:block;font-size:13.5px;margin-bottom:3px;color:var(--text)}
.risk span{font-size:12.3px;color:var(--muted);line-height:1.38;display:block}
.risk span::before{content:"→ ";color:var(--green);font-weight:700}

/* 12 team */
.team{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}
.mem{display:flex;gap:20px;padding:22px}
.mem .pic{width:150px;height:170px;flex:none;border-radius:12px;background-size:cover;background-position:center top}
.mem h3{font-size:22px}
.mem .role{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin:4px 0 10px}
.mem p{font-size:14px}
.mem .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.mem .chips span{font-size:11px;padding:3px 9px;border-radius:999px;border:1px solid var(--line);color:#cfe0ea}
.tbot{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:18px}
.tbot div{padding:16px 20px;border-radius:12px;border:1px solid var(--line2);background:rgba(11,33,53,.5)}
.tbot b{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:6px}
.tbot p{font-size:14px}

/* 13 ask */
.ask{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}
.askc{padding:22px 24px}
.askc .lab{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin-bottom:8px}
.askc h3{font-size:20px;margin-bottom:12px}
.askc ul{list-style:none}
.askc li{font-size:14px;color:var(--muted);padding:8px 0;border-top:1px solid var(--line2);line-height:1.4}
.askc li b{color:var(--text)}
.split{display:flex;justify-content:space-between;gap:12px}
.close{margin-top:auto;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.close img{height:44px}
.close .t{font-size:26px;font-weight:800}
.close .t em{font-style:normal;color:var(--cyan)}
.close .c{font-size:14px;color:var(--muted);text-align:right;line-height:1.6}

/* ---- density pass: fill the 16:9 canvas ---- */
.fill{flex:1;margin-bottom:34px;min-height:0}
.s-pos .r{width:400px}
.s-pos .r .phone{width:400px;height:540px;background-position:18% center}
.prob{padding:30px 30px 28px}
.prob h3{font-size:21px;margin-bottom:14px}
.prob p{font-size:16.5px;line-height:1.55}
.prob .big{font-size:54px}
.cols3{margin-top:34px}
.punch .t{font-size:28px}
.sol .img{height:230px}
.sol p{font-size:15.5px}
.why strong{color:var(--text);font-weight:700}
.mk{margin-top:30px}
.mkc{padding:28px 30px;display:flex;flex-direction:column}
.stat{margin-bottom:22px}
.stat .v{font-size:52px}
.stat p{font-size:15.5px}
.mkc .so{font-size:14.5px;margin-top:auto}
.tam{margin-top:0}
.tam p{font-size:15px}
.ctab td{font-size:14.5px;padding:15px 18px}
.ctab th{padding:14px 18px}
.ctab td:first-child{width:170px}
.lessons{width:360px;padding:26px 26px}
.lessons li{font-size:14.5px;padding:16px 0}
.lessons li b{font-size:16px}
.s-mod .stp .phone{width:170px;height:290px}
.s-mod .stp .pnl{width:290px;height:160px}
.s-mod .steps{width:330px;gap:16px}
.s-mod .steps div{font-size:15px}
.rev td{font-size:14px;padding:11px 16px}
.mvp{padding:26px}
.mvp .phone{width:210px;height:380px}
.mvp li{font-size:15px;padding:8px 0 8px 24px}
.thumbs div{height:128px}
.trac{padding:26px 28px;display:flex;flex-direction:column}
.kpis{gap:14px;margin-top:18px}
.kpis div{padding:18px 18px}
.kpis b{font-size:30px}
.kpis span{font-size:14px}
.meas{font-size:15px;margin-top:auto;line-height:1.55}
.phase{padding:24px 26px}
.phase h3{font-size:20px}
.phase li{font-size:15px;padding:6px 0 6px 16px}
.phase li::before{top:14px}
.risks{gap:12px;margin-top:20px}
.risk{padding:15px 18px}
.risk b{font-size:15px}
.risk span{font-size:14px}
.mem{padding:28px;gap:26px}
.mem .pic{width:190px;height:240px}
.mem h3{font-size:25px}
.mem p{font-size:15.5px;line-height:1.55}
.mem .chips span{font-size:12px;padding:4px 11px}
.tbot div{padding:20px 24px}
.tbot p{font-size:15.5px}
.askc{padding:28px 30px}
.askc h3{font-size:23px;margin-bottom:16px}
.askc li{font-size:15.5px;padding:13px 0}
.close img{height:52px}
.close .t{font-size:30px}

.s-mod .stp .phone{width:150px;height:250px}
.s-mod .stp .pnl{width:270px;height:140px}
.s-mod .top{margin-top:16px}
.rev{margin-top:14px}
.rev td{font-size:13.5px;padding:8px 16px}
.rev td:first-child{width:230px}
.rev th{padding:9px 16px}
.sol .img.bk{background-position:center 75%}
.s-prod .scr{width:212px}
.s-prod .scr .phone{width:212px;height:390px}
.s-prod .scr p{font-size:14px}
.s-prod .flow span,.s-prod .feat span{font-size:13.5px}
.s-prod .feat div{padding:15px 16px}
.s-prod .feat b{font-size:15px}
.ter .pics{height:124px}
.ter td{font-size:13.4px;padding:6px 0}
.open{display:flex;align-items:center;gap:16px;margin-top:16px}
.open b{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--green);white-space:nowrap}
.chips2{display:flex;flex-wrap:wrap;gap:6px}
.chips2 span{font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid var(--line);color:#cfe0ea;background:rgba(11,33,53,.6)}
.chips2 span:last-child{border-style:dashed;color:var(--cyan)}
.s-terr .terr{margin-top:14px}
.kpis.q b{font-size:16px;line-height:1.3;margin-bottom:6px}
.kpis.q span{font-size:13.5px;color:var(--cyan)}
.s-terr .ter .pics{height:140px}
.s-terr .ter .b{padding:13px 20px 12px}
.s-terr .ter h3{margin-bottom:7px}
.s-terr .why{margin-top:14px;padding:15px 22px}
.s-terr .why p{font-size:13.5px}
.s-terr h2{max-width:none;font-size:34px}
.s-terr .chips2{gap:5px}
.s-terr .chips2 span{font-size:11.5px;padding:3px 9px}
.s-terr .open{margin-top:14px;gap:12px}
.mem .pic{height:215px}
.askc{padding:24px 28px}
.askc h3{margin-bottom:10px}
.askc li{font-size:15px;padding:9px 0}
.close{margin-top:18px}
@media print{
  @page{size:1280px 720px;margin:0}
  html,body{background:var(--bg);padding:0}
  .deck{gap:0;display:block}
  .frame{width:1280px!important;height:720px!important;page-break-after:always;break-after:page}
  .slide{transform:none!important}
}
@media screen and (max-width:1320px){ body{padding:12px 0} .deck{gap:12px} }
</style>
</head>
<body>
<main class="deck">

<!-- 1. COUVERTURE -->
<div class="frame"><section class="slide s-cover">
  <div class="bgimg" style="background-image:url(data:image/jpeg;base64,)"></div>
  <div class="shade"></div>
  <div class="in">
    <img class="logo" src="data:image/png;base64," alt="Vuvio">
    <h1>Le monde,<br><em>vu de l'intérieur.</em></h1>
    <p class="sub">Vuvio est une plateforme de live en vue subjective. On y regarde une activité à travers les yeux de celui qui la pratique, au moment où il la pratique.</p>
    <div class="meta"><span><b>vuvio.app</b></span><span>MVP en ligne · mobile et ordinateur</span><span>Dossier incubateurs &amp; investisseurs · Novembre 2026</span></div>
  </div>
</section></div>

<!-- 2. POSITIONNEMENT -->
<div class="frame"><section class="slide s-pos">
  <div class="l">
    <div class="kicker">01 — Vuvio en une phrase</div>
    <p class="statement">Vuvio est la plateforme du <em>live à la première personne</em>. On n'y entre pas par un compte à suivre, mais par une activité ou un lieu sur la carte, et on la vit à travers les yeux de celui qui la pratique.</p>
    <dl>
      <dt>Le format</dt><dd><b>Du direct filmé en vue subjective</b>, au téléphone ou à la caméra d'action. Aucun montage : le créateur lance le live et continue ce qu'il fait.</dd>
      <dt>La découverte</dt><dd><b>Par activité</b> (escalade, cuisine, mode, concert…) <b>ou par lieu</b>, grâce au Globe. On découvre la personne ensuite, puis on la suit.</dd>
      <dt>Les thèmes</dt><dd><b>Tout ce qui se vit et se filme</b> : sport, métiers, voyage, lifestyle, mode, musique, événements… Pour démarrer, l'équipe concentre ses actions sur <b>trois terrains de lancement</b> : outdoor, métiers &amp; savoir-faire, territoires &amp; tourisme.</dd>
      <dt>Le revenu</dt><dd>Le <b>matériel et les produits visibles pendant le live</b> (affiliation, marques), et des <b>lives soutenus par des partenaires</b> : filières, territoires, organisateurs.</dd>
      <dt>L'état</dt><dd><b>MVP fonctionnel en ligne</b> sur vuvio.app. Prochaine étape : un pilote avec de vrais créateurs.</dd>
    </dl>
  </div>
  <div class="r">
    <div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div>
    <p class="note">Capture de l'application · contenu de démonstration</p>
  </div>
  <div class="foot"><span></span><span class="pg">Vuvio · 02</span></div>
</section></div>

<!-- 3. PROBLEME -->
<div class="frame"><section class="slide">
  <div class="kicker">02 — Le problème</div>
  <h2>La vidéo en ligne montre le résultat. <em>Rarement le geste.</em></h2>
  <div class="cols3">
    <div class="card prob">
      <div class="who">Ceux qui regardent</div>
      <h3>Pour voir un métier ou une pratique, il faut déjà savoir qui suivre.</h3>
      <p>Les plateformes proposent des vidéos montées, choisies à partir des comptes qu'on suit. Voir comment travaille un couvreur, ou à quoi ressemble une arête en haute montagne, en vrai et sans mise en scène, reste difficile.</p>
    </div>
    <div class="card prob">
      <div class="who">Ceux qui pratiquent</div>
      <h3>Les mains sont occupées, le montage n'est pas leur métier.</h3>
      <p>Une guide, un artisan, un musicien en coulisses ou une styliste avant un défilé n'a ni le temps de monter des vidéos ni forcément d'audience de départ. Le live existant favorise ceux qui parlent face caméra, pas ceux qui font quelque chose.</p>
    </div>
    <div class="card prob">
      <div class="who">Filières &amp; territoires</div>
      <div class="big">50,1 %</div>
      <p>des projets de recrutement jugés difficiles en France en 2025, jusqu'à <b style="color:var(--text)">82 %</b> pour les couvreurs. Les métiers manuels peinent à se montrer, et les territoires communiquent surtout avec des vidéos promotionnelles produites.</p>
    </div>
  </div>
  <div class="punch"><div class="t">Le live d'aujourd'hui filme surtout la personne. <em>Vuvio filme ce qu'elle voit.</em></div></div>
  <div class="foot"><span class="src">Source : France Travail, enquête Besoins en main-d'œuvre (BMO) 2025.</span><span class="pg">Vuvio · 03</span></div>
</section></div>

<!-- 4. SOLUTION -->
<div class="frame"><section class="slide">
  <div class="kicker">03 — La solution</div>
  <h2>Un live à la première personne, qu'on trouve <em>par l'activité ou par la carte.</em></h2>
  <div class="cols3" style="margin-top:24px">
    <div class="card sol">
      <div class="img bk" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div class="b"><div class="n">VUE SUBJECTIVE</div><h3>On voit ce que voit le créateur</h3>
      <p>Ses mains, son outil, le terrain, les imprévus. Un téléphone sur harnais ou une caméra d'action suffisent.</p></div>
    </div>
    <div class="card sol">
      <div class="img" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div class="b"><div class="n">ENTRÉE PAR L'ACTIVITÉ</div><h3>On choisit ce qu'on veut voir, pas qui</h3>
      <p>« Cuisine », « escalade », « coulisses de défilé » : on tombe sur ceux qui sont en direct maintenant, sans les connaître à l'avance.</p></div>
    </div>
    <div class="card sol">
      <div class="img" style="background-image:url(data:image/jpeg;base64,);background-position:top"></div>
      <div class="b"><div class="n">LE GLOBE</div><h3>On explore le monde par ses lives</h3>
      <p>Chaque live est placé sur une carte. On ouvre une vallée, une ville, un pays, et on voit ce qui s'y passe à l'instant.</p></div>
    </div>
  </div>
  <div class="formula">
    <div class="eq"><span>ACTIVITÉ</span> + VUE SUBJECTIVE + <span>GÉOGRAPHIE</span></div>
    <p>Chaque brique existe ailleurs séparément. Vuvio est construit autour de leur combinaison.</p>
  </div>
  <div class="foot"><span class="note">Captures de l'application · contenus de démonstration</span><span class="pg">Vuvio · 04</span></div>
</section></div>

<!-- 5. PRODUIT -->
<div class="frame"><section class="slide s-prod">
  <div class="kicker">04 — Le produit</div>
  <h2>Trois portes d'entrée, <em>déjà en ligne.</em></h2>
  <div class="row">
    <div class="ph3">
      <div class="scr"><div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div><h3>Watch</h3><p>On entre directement dans un live et on passe d'une expérience à l'autre d'un geste.</p></div>
      <div class="scr"><div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div><h3>Globe</h3><p>Les lives en cours, placés sur la carte du monde.</p></div>
      <div class="scr"><div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div><h3>Explore</h3><p>Par centre d'intérêt, par activité, par proximité.</p></div>
    </div>
    <div class="side">
      <div class="sidehead">Le parcours spectateur</div>
      <div class="flow">
        <div><b>Découvrir</b><span>Watch, Explore ou Globe</span></div>
        <div><b>Explorer</b><span>L'activité, puis la personne</span></div>
        <div><b>Suivre</b><span>Un créateur ou un centre d'intérêt</span></div>
        <div><b>Revenir</b><span>Ses lives à venir, ses replays</span></div>
      </div>
      <div class="sidehead" style="margin-top:8px">Autour du live</div>
      <div class="feat">
        <div><b>Start Live</b><span>Préparer, cadrer et lancer un live en quelques gestes.</span></div>
        <div><b>Profil créateur</b><span>Centres d'intérêt, lives passés et à venir, bouton suivre.</span></div>
        <div><b>Sac à dos</b><span>Le matériel réellement utilisé, consultable pendant le live.</span></div>
        <div><b>Replay &amp; recap</b><span>Les temps forts après le direct. <i style="color:var(--amber);font-style:normal">En cours.</i></span></div>
      </div>
    </div>
  </div>
  <div class="foot"><span class="note">Captures de l'application vuvio.app · créateurs et contenus de démonstration</span><span class="pg">Vuvio · 05</span></div>
</section></div>

<!-- 6. TROIS TERRAINS -->
<div class="frame"><section class="slide s-terr">
  <div class="kicker">05 — Un format ouvert, trois terrains de lancement</div>
  <h2>Tout ce qui se vit peut se regarder. <em>Trois terrains pour lancer.</em></h2>
  <div class="open"><b>Ouvert à</b><div class="chips2"><span>Lifestyle</span><span>Mode &amp; coulisses</span><span>Musique</span><span>Voyage</span><span>Événements</span><span>Gastronomie</span><span>Sport</span><span>Nature</span><span>Vie urbaine</span><span>Sciences</span><span>Et tout ce qui se filme…</span></div></div>
  <div class="terr">
    <div class="card ter">
      <div class="pics"><div style="background-image:url(data:image/jpeg;base64,)"></div><div style="background-image:url(data:image/jpeg;base64,)"></div></div>
      <div class="b"><h3><i>A</i> Outdoor &amp; aventure</h3>
      <table>
        <tr><td>On y voit</td><td>Une course en montagne, une sortie VTT, un vol en parapente.</td></tr>
        <tr><td>Diffusent</td><td>Guides, moniteurs, sportifs.</td></tr>
        <tr><td>Regardent</td><td>Pratiquants, futurs pratiquants, curieux.</td></tr>
        <tr class="pay"><td>Paient</td><td>Équipementiers et marques de caméras, via le matériel visible en live.</td></tr>
      </table></div>
    </div>
    <div class="card ter">
      <div class="pics"><div style="background-image:url(data:image/jpeg;base64,)"></div><div style="background-image:url(data:image/jpeg;base64,)"></div></div>
      <div class="b"><h3><i>B</i> Métiers &amp; savoir-faire</h3>
      <table>
        <tr><td>On y voit</td><td>Un chef pendant le service, un menuisier à l'établi, un couvreur sur le toit.</td></tr>
        <tr><td>Diffusent</td><td>Artisans, chefs, apprentis.</td></tr>
        <tr><td>Regardent</td><td>Jeunes en orientation, personnes en reconversion, curieux.</td></tr>
        <tr class="pay"><td>Paient</td><td>Filières, chambres de métiers, CFA et écoles qui veulent montrer le métier réel.</td></tr>
      </table></div>
    </div>
    <div class="card ter">
      <div class="pics"><div style="background-image:url(data:image/jpeg;base64,)"></div><div style="background-image:url(data:image/jpeg;base64,);background-position:center 40%"></div></div>
      <div class="b"><h3><i>C</i> Territoires &amp; tourisme</h3>
      <table>
        <tr><td>On y voit</td><td>Un marché, une randonnée, une cave, un concert local.</td></tr>
        <tr><td>Diffusent</td><td>Guides, producteurs, acteurs culturels locaux.</td></tr>
        <tr><td>Regardent</td><td>Voyageurs qui préparent un séjour, curieux, diaspora.</td></tr>
        <tr class="pay"><td>Paient</td><td>Offices de tourisme et agences d'attractivité.</td></tr>
      </table></div>
    </div>
  </div>
  <div class="why"><b>Pourquoi ces trois</b><p>Ce sont des <strong>thèmes de travail pour l'équipe</strong> (recruter des créateurs, nouer des partenariats, mesurer), pas des limites : chacun ouvre un public. Sur le Globe, ils se renforcent : venu pour une course en montagne, on découvre l'artisan de la même vallée. Et chacun a <strong>son propre payeur</strong>.</p></div>
  <div class="foot"><span class="note">Visuels : captures et contenus de démonstration</span><span class="pg">Vuvio · 06</span></div>
</section></div>

<!-- 7. MARCHE -->
<div class="frame"><section class="slide">
  <div class="kicker">06 — Le marché</div>
  <h2>Un format qui progresse, <em>des budgets déjà en place.</em></h2>
  <div class="mk fill" style="margin-bottom:18px">
    <div class="card mkc">
      <div class="lab">Le live</div>
      <div class="stat"><div class="v">36,4 Md<small>d'heures</small></div><p>de live regardées dans le monde en 2025, en hausse de 6 % sur un an : le plus haut niveau depuis 2021.</p></div>
      <div class="so">Les marques d'équipement outdoor et de caméras d'action rémunèrent déjà des créateurs pour montrer leur matériel en situation. Vuvio leur offre ce moment en direct, avec le lien produit à portée de main.</div>
    </div>
    <div class="card mkc">
      <div class="lab">Métiers &amp; savoir-faire</div>
      <div class="stat"><div class="v">2,43 M</div><p>projets de recrutement en France en 2025, dont la moitié jugés difficiles.</p></div>
      <div class="stat"><div class="v">1,52 M</div><p>entreprises artisanales actives en France.</p></div>
    </div>
    <div class="card mkc">
      <div class="lab">L'économie des créateurs</div>
      <div class="stat"><div class="v">250 Md$</div><p>en 2023, et jusqu'à <b style="color:var(--text)">480 Md$</b> projetés en 2027 : publicité, partenariats de marque, affiliation.</p></div>
      <div class="stat"><div class="v">50 M</div><p>de créateurs dans le monde. Le live en vue subjective leur ouvre un format nouveau, sans limite de thème.</p></div>
    </div>
  </div>
  <div class="tam" style="margin-bottom:34px;border-color:var(--line)"><p><b style="color:var(--text)">Marché adressable</b> : il sera chiffré pendant l'incubation, à partir des données réelles du pilote (créateurs actifs, audience, revenus par live).</p></div>
  <div class="foot"><span class="src">Sources : Stream Hatchet, rapport annuel 2025 · France Travail, BMO 2025 · Baromètre ISM–MAAF (entreprises au 1er janvier 2024) · Goldman Sachs, « The creator economy could approach half-a-trillion dollars by 2027 », avril 2023.</span><span class="pg">Vuvio · 07</span></div>
</section></div>

<!-- 8. CONCURRENCE -->
<div class="frame"><section class="slide s-comp">
  <div class="kicker">07 — Concurrence</div>
  <h2>Ce qui existe, ce qui a échoué, <em>ce que nous en retenons.</em></h2>
  <div class="wrap fill">
    <table class="ctab">
      <tr><th>Acteur</th><th>Ce qu'il fait bien</th><th>Ce qui manque pour notre usage</th></tr>
      <tr><td>Twitch</td><td>Le live au cœur du produit ; catégories IRL, Travel &amp; Outdoors, Food &amp; Drink.</td><td>On suit une chaîne. Le format reste centré sur le streamer qui parle à son public.</td></tr>
      <tr><td>TikTok · Instagram Live</td><td>Audience massive, live shopping.</td><td>Le live est une fonction secondaire ; on y arrive par un compte déjà suivi.</td></tr>
      <tr><td>YouTube Live</td><td>Écosystème vidéo, replay, recherche.</td><td>On découvre par chaîne ou mot-clé, pas par activité en cours ni par lieu.</td></tr>
      <tr class="dead"><td>Periscope<small>2015 – fermé en 2021</small></td><td>Une carte du monde des lives, dès 2015.</td><td>Des lives sans thème : la carte montrait tout, sans fil conducteur.</td></tr>
      <tr class="dead"><td>Heygo<small>fermé en 2023</small></td><td>Visites guidées en live, 20 M$ levés en 2022.</td><td>Un seul usage, né du confinement, et un revenu fondé sur les pourboires.</td></tr>
      <tr class="us"><td>Vuvio</td><td>Vue subjective + entrée par activité + Globe.</td><td>À prouver : la régularité des lives et le retour des spectateurs.</td></tr>
    </table>
    <div class="card lessons">
      <h3>Nos choix</h3>
      <ol>
        <li><b>Une carte ne suffit pas.</b>On entre par une activité, et les lives sont classés et accompagnés.</li>
        <li><b>Un usage unique est fragile.</b>Un format ouvert à toute activité, lancé par trois terrains aux payeurs différents.</li>
        <li><b>Le pourboire ne fait pas un modèle.</b>Revenus B2B identifiés dès le départ, en plus de l'affiliation.</li>
      </ol>
    </div>
  </div>
  <div class="foot"><span class="src">Sources : Periscope (Wikipedia ; ajout de la carte en 2015, iMore) · Skift, « Why Travel Tech Startup Heygo Closed a Year After Raising $20 Million », avril 2023. Colonne « ce qui manque » : notre analyse.</span><span class="pg">Vuvio · 08</span></div>
</section></div>

<!-- 9. MODELE -->
<div class="frame"><section class="slide s-mod">
  <div class="kicker">08 — Modèle économique</div>
  <h2>Le « sac à dos » : <em>le matériel visible au moment où il sert.</em></h2>
  <div class="top">
    <div class="stp">
      <div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div class="pnl" style="background-image:url(data:image/jpeg;base64,)"></div>
        <div class="pnl" style="background-image:url(data:image/jpeg;base64,);height:96px"></div>
      </div>
    </div>
    <div class="steps">
      <div><i>1</i><b>Pendant le live</b>, le spectateur touche l'icône sac à dos du créateur.</div>
      <div><i>2</i><b>Le panneau s'ouvre</b> : couteau, thermomètre, harnais, caméra, tout ce qui sert à cet instant.</div>
      <div><i>3</i><b>Un lien mène au produit</b>, chez un partenaire ou en affiliation. Le créateur touche une part du revenu généré.</div>
    </div>
  </div>
  <table class="rev">
    <tr><th>Source de revenu</th><th>Qui paie, pour quoi</th><th>Quand</th></tr>
    <tr><td>Affiliation</td><td>Commission sur les achats faits depuis le sac à dos.</td><td class="when">Dès le pilote</td></tr>
    <tr><td>Marques &amp; équipementiers</td><td>Matériel montré en usage réel, lives et créateurs soutenus, produits mis en avant.</td><td class="when">Pilote → 12 mois</td></tr>
    <tr><td>Filières &amp; formation</td><td>Séries de lives « métier » pour l'orientation et le recrutement (chambres de métiers, branches, CFA).</td><td class="when">Pilote → 12 mois</td></tr>
    <tr><td>Territoires</td><td>Présence renforcée sur le Globe, lives d'acteurs locaux soutenus par l'office de tourisme.</td><td class="when">Pilote → 12 mois</td></tr>
    <tr><td>Outils créateurs</td><td>Fonctions avancées pour les créateurs réguliers (gestion du matériel, statistiques).</td><td class="when">Au-delà de 12 mois</td></tr>
  </table>
  <div class="foot"><span class="note">Prix, commissions et partage avec les créateurs : fixés à partir des résultats du pilote.</span><span class="pg">Vuvio · 09</span></div>
</section></div>

<!-- 10. AVANCEMENT -->
<div class="frame"><section class="slide s-stat">
  <div class="kicker">09 — Où en est le projet</div>
  <h2>Le produit fonctionne. <em>Il reste à prouver l'usage.</em></h2>
  <div class="grid fill">
    <div class="card mvp">
      <div class="phone" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div style="flex:1">
        <span class="tag">MVP en ligne · vuvio.app</span>
        <ul>
          <li>Lancer un live depuis un téléphone</li>
          <li>Le regarder sur mobile ou ordinateur</li>
          <li>Watch, Explore et Globe opérationnels</li>
          <li>Profils créateurs et abonnements</li>
          <li>Sac à dos : matériel affiché pendant le live</li>
          <li class="wip">Replay &amp; recap : en développement</li>
        </ul>
        <div class="thumbs">
          <div style="background-image:url(data:image/jpeg;base64,)"><span>Outdoor</span></div>
          <div style="background-image:url(data:image/jpeg;base64,)"><span>Artisanat</span></div>
          <div style="background-image:url(data:image/jpeg;base64,)"><span>Cuisine</span></div>
          <div style="background-image:url(data:image/jpeg;base64,)"><span>Musique</span></div>
        </div>
      </div>
    </div>
    <div class="card trac">
      <span class="tag ghost">Ce que le pilote doit prouver</span>
      <div class="kpis q">
        <div><b>Les spectateurs reviennent-ils ?</b><span>Part de retour sous 7 jours</span></div>
        <div><b>Le live retient-il ?</b><span>Temps moyen passé par live</span></div>
        <div><b>Les créateurs diffusent-ils souvent ?</b><span>Lives par créateur et par mois</span></div>
        <div><b>Le sac à dos convertit-il ?</b><span>Clics et achats depuis le panneau</span></div>
      </div>
      <p class="meas"><b>Pas encore d'utilisateurs publics :</b> le produit est prêt, l'ouverture se fera avec le pilote. Ces indicateurs seront suivis dès le premier live.</p>
    </div>
  </div>
  <div class="foot"><span class="note">Vignettes : formats de démonstration</span><span class="pg">Vuvio · 10</span></div>
</section></div>

<!-- 11. FEUILLE DE ROUTE & RISQUES -->
<div class="frame"><section class="slide">
  <div class="kicker">10 — Feuille de route &amp; risques</div>
  <h2>18 mois pour valider l'usage <em>et le premier revenu.</em></h2>
  <div class="phases" style="margin-top:30px">
    <div class="card phase"><div class="when">0 – 6 mois</div><h3>Un territoire pilote</h3><ul>
      <li>Une région où les trois terrains se croisent (montagne, savoir-faire, tourisme)</li>
      <li>Une première cohorte de créateurs recrutés et accompagnés</li>
      <li>Lives programmés chaque semaine</li></ul></div>
    <div class="card phase"><div class="when">6 – 12 mois</div><h3>Premiers revenus</h3><ul>
      <li>Affiliation active sur le sac à dos</li>
      <li>Un premier partenaire par terrain : une marque, une filière, un office de tourisme</li>
      <li>Replay &amp; recap en production</li></ul></div>
    <div class="card phase"><div class="when">12 – 18 mois</div><h3>Étendre</h3><ul>
      <li>Nouveaux territoires et nouveaux thèmes : lifestyle, mode, événements…</li>
      <li>Outils pour les créateurs réguliers</li>
      <li>Préparation d'une levée de fonds</li></ul></div>
  </div>
  <div class="risks">
    <div class="risk"><b>Un live peut être creux</b><span>Formats préparés avec le créateur, lives courts, replay des temps forts.</span></div>
    <div class="risk"><b>Réseau faible en extérieur</b><span>Qualité adaptative, enregistrement local, replay différé.</span></div>
    <div class="risk"><b>Plateforme à deux faces</b><span>Créateurs recrutés avant d'ouvrir au public ; lives programmés à l'avance.</span></div>
    <div class="risk"><b>Droit à l'image &amp; RGPD</b><span>Charte de tournage, consentement des personnes filmées, floutage.</span></div>
    <div class="risk"><b>Modération du direct (DSA)</b><span>Signalement, coupure de live, modération humaine pendant le pilote.</span></div>
    <div class="risk"><b>Sécurité du créateur</b><span>Aucune interaction exigée pendant l'effort ; charte pour les activités à risque.</span></div>
  </div>
  <div class="foot"><span></span><span class="pg">Vuvio · 11</span></div>
</section></div>

<!-- 12. EQUIPE -->
<div class="frame"><section class="slide">
  <div class="kicker">11 — L'équipe</div>
  <h2>Un profil produit et technique, <em>un profil marché et partenariats.</em></h2>
  <div class="team" style="margin-top:24px">
    <div class="card mem">
      <div class="pic" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div><h3>Alexandre Ranson</h3><div class="role">Cofondateur · Produit &amp; technologie</div>
      <p>Formation en informatique et génie logiciel, parcours dans la musique et la production. Il porte le produit et son développement technique : architecture, diffusion live, expérience utilisateur.</p>
      <div class="chips"><span>Produit</span><span>Développement</span><span>Vidéo live</span><span>UX</span><span>Production audio-vidéo</span></div></div>
    </div>
    <div class="card mem">
      <div class="pic" style="background-image:url(data:image/jpeg;base64,)"></div>
      <div><h3>Cécilia Ranson</h3><div class="role">Cofondatrice · Marketing, stratégie &amp; partenariats</div>
      <p>Expérience en marketing, stratégie et développement de marché, notamment chez leboncoin. Sur Vuvio : positionnement, partenariats avec marques, filières et territoires, communauté de créateurs.</p>
      <div class="chips"><span>Marketing</span><span>Stratégie</span><span>Partenariats</span><span>Communauté</span></div></div>
    </div>
  </div>
  <div class="tbot" style="margin-top:20px">
    <div><b>Déjà fait ensemble</b><p>Positionnement, conception et mise en ligne du MVP, choix des terrains de lancement.</p></div>
    <div><b>À renforcer avec l'incubation</b><p>Expertise tourisme et filières métiers, acquisition de créateurs, conseil juridique.</p></div>
  </div>
  <div class="foot"><span></span><span class="pg">Vuvio · 12</span></div>
</section></div>

<!-- 13. BESOIN -->
<div class="frame"><section class="slide">
  <div class="kicker">12 — Ce que nous cherchons</div>
  <h2>Passer d'un produit qui marche <em>à un usage prouvé.</em></h2>
  <div class="ask" style="margin-top:24px">
    <div class="card askc">
      <div class="lab">Accompagnement</div>
      <h3>Un incubateur pour structurer et ouvrir des portes</h3>
      <ul>
        <li><b>Business plan</b> et chiffrage du modèle à partir des données du pilote</li>
        <li><b>Mises en relation</b> : chambres de métiers et CFA, offices de tourisme, marques d'équipement</li>
        <li><b>Financements non dilutifs</b> : prêts d'honneur, aides à l'innovation</li>
        <li><b>Appui juridique</b> : droit à l'image, conditions d'utilisation, obligations DSA</li>
      </ul>
    </div>
    <div class="card askc">
      <div class="lab">Financement</div>
      <h3>Un premier financement pour lancer le pilote</h3>
      <ul>
        <li><b>Infrastructure de diffusion</b> : hébergement et coûts du live à mesure que l'audience grandit</li>
        <li><b>Pilote</b> : recrutement, équipement et accompagnement des premiers créateurs</li>
        <li><b>Partenariats</b> : marques, filières, territoires, et acquisition des spectateurs</li>
        <li><b>Juridique</b> et conformité</li>
                <li style="color:var(--text)">Le montant sera établi avec l'incubateur, à partir du chiffrage précis de ces besoins.</li>
      </ul>
    </div>
  </div>
  <div class="close">
    <img src="data:image/png;base64," alt="Vuvio">
    <div class="t">Le monde, <em>vu de l'intérieur.</em></div>
    <div class="c">vuvio.app<br><b style="color:var(--text)">hello@vuvio.app</b></div>
  </div>
  <div class="foot"><span></span><span class="pg">Vuvio · 13</span></div>
</section></div>

</main>
<script>
(function(){
  function fit(){
    var w=Math.min(window.innerWidth-16,1280), s=w/1280;
    document.querySelectorAll('.frame').forEach(function(f){
      f.style.width=(1280*s)+'px'; f.style.height=(720*s)+'px';
      f.firstElementChild.style.transform='scale('+s+')';
    });
  }
  if(!window.matchMedia('print').matches){ window.addEventListener('resize',fit); fit(); }
})();
</script>
</body>
</html>
