rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────
    match /users/{uid} {
      // Public profiles — readable by anyone
      allow read: if true;

      // Only the owner can create their own document
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && !('role' in request.resource.data)       // role set server-side
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount == 0);

      // Owner can update their own document (restricted fields cannot be changed)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == resource.data.accountStatus)
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount == resource.data.followerCount)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount == resource.data.followingCount)
        && (!('liveCount' in request.resource.data) || request.resource.data.liveCount == resource.data.liveCount);

      // No deletes
      allow delete: if false;
    }

    // ── User notifications (subcollection) ────────
    match /users/{uid}/notifications/{notifId} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'type', 'title', 'body', 'read', 'createdAt',
          'streamId', 'scheduledAt', 'creatorUid', 'creatorName',
          'followerUid', 'followerName', 'followerPhotoURL'
        ])
        && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Stream destinations — multistream config (NO stream keys stored) ──
    match /users/{uid}/streamDestinations/{destId} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !('streamKey' in request.resource.data)
        && request.resource.data.keys().hasOnly(['id', 'provider', 'name', 'streamUrl', 'enabled', 'createdAt', 'updatedAt', 'lastUsedAt']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !('streamKey' in request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Username reservations ──────────────────────
    match /usernames/{username} {
      allow read:   if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Active live sessions ───────────────────────
    function isPublicLive(data) {
      return data.get('publicSafe', false) == true;
    }

    function isPublicLiveWrite(data) {
      return isPublicLive(data)
        && data.get('visibility', '') == 'public'
        && data.get('privacy', '') == 'Everyone';
    }

    function hasNoLiveSecrets(data) {
      return !data.keys().hasAny([
          'streamKey', 'rtmpsStreamKey', 'webRTCUrl', 'ingestUrl',
          'rtmpsIngestUrl', 'ingest', 'credentials', 'apiToken'
        ]);
    }

    function approvedLiveFields() {
      return [
        'id', 'status', 'name', 'streamer', 'creatorUid', 'creatorId',
        'kind', 'job', 'city', 'country', 'countryCode', 'location',
        'locationLabel', 'privacy', 'visibility', 'publicSafe', 'quality',
        'viewers', 'viewerLabel', 'image', 'manualCoverDataUrl',
        'coordinates', 'family', 'subcategory', 'povType',
        'experienceTitle', 'title', 'description', 'backendStreamId',
        'cloudflareLiveInputId', 'cloudflareUid', 'liveInputId',
        'hlsManifestUrl', 'whepUrl', 'playbackUrl', 'chat', 'equipment',
        'equipmentSnapshots', 'equipmentConfirmed', 'equipmentUpdatedAt',
        'createdLocally', 'createdAt', 'updatedAt', 'signalSessionId',
        'sdpOffer', 'iceCandidates', 'liveStartedAt', 'liveEndedAt',
        'startedAt', 'endedAt', 'lastHeartbeatAt', 'recordingStatus',
        'broadcastIngestMode', 'latestPing', 'latestComment',
        'latestCommentAt', 'durationSeconds', 'totalUniqueViewers',
        'peakViewerCount', 'commentCount', 'starCount', 'coverImageUrl',
        'thumbnailUrl', 'coverSource', 'coverCapturedAt',
        'coverCaptureOffsetSeconds', 'replayUrl', 'recordingUid',
        'cloudflareVideoId', 'replayReadyAt', 'replayError',
        'replayCleanupPending', 'highlightStatus',
        'highlightUrl', 'highlightThumbnailUrl', 'highlightDurationSeconds',
        'endReason', 'currentViewerCount'
      ];
    }

    function canReadLive(liveId) {
      let live = get(/databases/$(database)/documents/activeLives/$(liveId)).data;
      return isPublicLive(live)
        || (request.auth != null && live.creatorUid == request.auth.uid)
        || isAdmin();
    }

    function isPublicLiveId(liveId) {
      return isPublicLive(get(/databases/$(database)/documents/activeLives/$(liveId)).data);
    }

    match /activeLives/{liveId} {
      allow get: if (isPublicLiveWrite(resource.data) && hasNoLiveSecrets(resource.data))
        || (request.auth != null && resource.data.creatorUid == request.auth.uid)
        || isAdmin();
      allow list: if isPublicLive(resource.data)
        || (request.auth != null && resource.data.creatorUid == request.auth.uid)
        || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.id == liveId
        && request.resource.data.get('creatorId', request.auth.uid) == request.auth.uid
        && request.resource.data.status == 'live'
        && isPublicLiveWrite(request.resource.data)
        && request.resource.data.keys().hasOnly(approvedLiveFields())
        && hasNoLiveSecrets(request.resource.data);
      allow update: if request.auth != null
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('creatorId', request.auth.uid) == request.auth.uid
        && isPublicLive(resource.data)
        && isPublicLiveWrite(request.resource.data)
        && request.resource.data.diff(resource.data).addedKeys().hasOnly(approvedLiveFields())
        && hasNoLiveSecrets(resource.data)
        && hasNoLiveSecrets(request.resource.data);
      allow delete: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;

      match /watchers/{watcherId} {
        allow read: if canReadLive(liveId);
        // P2P signaling docs — only allow the expected fields, no auth restriction
        // (SDP/ICE data is not sensitive; restricting by watcherUid caused permission failures)
        allow create: if isPublicLiveId(liveId)
          && request.resource.data.keys().hasOnly([
            'sdpAnswer',
            'signalSessionId',
            'watcherUid',
            'watcherIceCandidates',
            'updatedAt'
          ]);
        allow update: if isPublicLiveId(liveId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sdpAnswer',
            'signalSessionId',
            'watcherUid',
            'watcherIceCandidates',
            'updatedAt'
          ]);
        allow delete: if isPublicLiveId(liveId);
      }

      match /comments/{commentId} {
        allow read: if canReadLive(liveId);
        allow create: if isPublicLiveId(liveId)
          && request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'text',
            'userId',
            'userDisplayName',
            'userPhotoURL',
            'timestamp',
            'liveElapsedSeconds'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      match /stars/{starId} {
        allow read: if canReadLive(liveId);
        allow create: if isPublicLiveId(liveId)
          && request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId',
            'userDisplayName',
            'timestamp'
          ]);
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      match /questions/{questionId} {
        allow read: if canReadLive(liveId);

        // Viewer creates their own question — authorId must match auth UID, type forced to "question"
        allow create: if isPublicLiveId(liveId)
          && request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'text',
            'type',
            'authorId',
            'authorName',
            'authorAvatar',
            'streamCreatorId',
            'createdAt',
            'answered'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.type == 'question'
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.answered == false;

        // Only the live creator can answer — answer.authorId must match their uid
        allow update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/activeLives/$(liveId)).data.creatorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered', 'answer'])
          && request.resource.data.answered == true
          && request.resource.data.answer.authorId == request.auth.uid;

        // Only the question author can delete their own question
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Creator equipment ──────────────────────────
    match /creatorEquipment/{equipmentId} {
      allow read: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    // ── Post-live video analysis jobs ──────────────
    match /videoProcessingJobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.liveId is string
        && request.resource.data.sourceStoragePath is string
        && request.resource.data.status == 'queued';

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'highlightDecisions',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // ── Direct messages ────────────────────────────
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null
          || request.auth.uid in resource.data.participantIds
          || resource.data.participants[request.auth.uid] == true);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participants[request.auth.uid] == true
        && request.resource.data.participantIds.size() == 2;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow delete: if false;
        allow update: if false;
      }
    }

    // ── Analytics collections (admin-only read) ────
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') is string
          && (request.auth.token.email == 'alexandre.ranson@gmail.com' ||
            request.auth.token.email == 'doug.benchetrit@gmail.com' ||
            request.auth.token.email == 'cecilia.ranson@outlook.com' ||
            request.auth.token.email == 'christophe.ranson@gmail.com' ||
            request.auth.token.email.matches('.*@vuvio\\.app')))
      );
    }

    match /streamStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /creatorStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /categoryStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analyticsEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /websiteStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /visitorActivity/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Financial dashboard (admin SDK writes, admin read) ────────────
    match /adminFinancialData/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Product catalog ────────────────────────────
    match /products/{productId} {
      // Public product catalog
      allow read: if true;

      // Authenticated users can create/update products (for seeding and management)
      // In production, restrict to admins only via backend
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
