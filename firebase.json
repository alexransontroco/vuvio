{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/audio/**",
      "**/*.mov",
      "**/*.webm",
      "**/*.wav",
      "**/*.m4a"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/waitlist",
        "function": { "functionId": "waitlist", "region": "europe-west1" }
      },
      {
        "source": "/api/waitlist/**",
        "function": { "functionId": "waitlist", "region": "europe-west1" }
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/share/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
