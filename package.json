{
  "name": "vuvio-lab",
  "private": true,
  "version": "0.1.0-lab",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:relay": "npm --prefix relay start",
    "dev:replay": "sh -c 'npm run dev:relay & relay_pid=$!; npm run dev -- --host 0.0.0.0 --port 5174; kill $relay_pid'",
    "build": "vite build",
    "mobile:build": "npm run build && cap sync",
    "cap:sync": "cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "preview": "vite preview --port 4174",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "predeploy": "node ./scripts/guard-no-prod-deploy.js",
    "deploy": "echo 'Production deploy from Vuvio-Lab is blocked. Transfer features to main first.' && exit 1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@zip.js/zip.js": "^2.8.34",
    "firebase": "^12.16.0",
    "framer-motion": "^14.11.1",
    "hls.js": "^1.7.2",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.24.0",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.28.2",
    "three": "^0.186.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "typescript": "^5.9.3"
  }
}
